# Quote assistant — set ONE of these in Vercel (Project → Settings → Environment Variables)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: override the model ids (defaults shown). Change these here if a model is ever retired.
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-2.5-flash

# Shared database (already has built-in fallbacks in code; set these to use your own project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
