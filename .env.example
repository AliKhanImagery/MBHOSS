# Quote assistant (free): get a key at https://aistudio.google.com/apikey and add it in
# Vercel → Project → Settings → Environment Variables as GEMINI_API_KEY, then redeploy.
GEMINI_API_KEY=

# Optional. Models are tried in this order; each has its own free allowance, so the second is a safety net.
# Change here if Google ever retires a model.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-2.5-flash,gemini-2.5-flash-lite

# Optional paid alternative (not needed): set AI_PROVIDER=anthropic and ANTHROPIC_API_KEY to use Claude.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Shared database (the code has built-in fallbacks; set these to use your own project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
